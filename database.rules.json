{
  "rules": {
    "youtube_room": {
      ".read": true,
      ".write": true,
      ".validate": "newData.hasChildren(['videoId', 'playing', 'position', 'updatedAt'])",
      "videoId": { ".validate": "newData.isString() && newData.val().matches(/^[a-zA-Z0-9_-]{11}$/)" },
      "playing": { ".validate": "newData.isBoolean()" },
      "position": { ".validate": "newData.isNumber() && newData.val() >= 0" },
      "updatedAt": { ".validate": "newData.isNumber()" },
      "$other": { ".validate": false }
    },
    "memoryCorner": {
      ".read": true,
      ".write": true
    },
    "status": {
      ".read": true,
      ".write": true
    },
    "pending_cards": {
      ".read": true,
      ".write": true
    },
    "archived_cards": {
      ".read": true,
      ".write": true
    },
    "letters": {
      ".read": true,
      ".write": true
    },
    "daily_chat": {
      ".read": true,
      ".write": true
    },
    "pet_state": {
      ".read": true,
      ".write": true
    },
    "music_state": {
      ".read": true,
      ".write": true
    },
    "slideshow_state": {
      ".read": true,
      ".write": true
    },
    "clock_icon_state": {
      ".read": true,
      ".write": true
    },
    "game_invitations": {
      ".read": true,
      ".write": true
    },
    "xo_game": {
      ".read": true,
      ".write": true
    },
    "word_game": {
      ".read": true,
      ".write": true
    }
  }
}
